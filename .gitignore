
# Bí mật — `.env.example` là bản mẫu và ĐƯỢC commit; `.env` là bản thật và không bao giờ commit.
.env
.env.*
!.env.example

# Toolchain (the app lives in client/; automation-testing/ has its own node_modules)
node_modules/
.next/
client/out/
client/out-auth/
client/out-flagoff/
dist/
*.tsbuildinfo

# Test output (automation-testing/ and any Playwright run)
test-results/
playwright-report/
playwright/.cache/

# git worktrees live here (feature-flow section 3); they are checkouts, not content
/.worktrees/

# --- Claude Code: theo doi config + skills, bo qua worktrees/doc-state ---
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.local.json
!/.claude/skills/
!/.claude/scripts/
!/.claude/agents/

# playwright MCP scratch output
/.playwright-mcp/
