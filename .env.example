# Biến môi trường — BẢN MẪU. Copy thành `.env` rồi điền giá trị thật.
#
#   cp .env.example .env
#
# Trả lời câu hỏi: cần biến nào để chạy được dự án này?
# Trạng thái:     🟢 đủ
# Cập nhật khi:    code đọc một biến mới (process.env.X / os.getenv / os.Getenv / ...)
#
# HAI QUY TẮC
#   1. File này KHÔNG chứa giá trị thật. Chỉ tên biến + cách lấy giá trị.
#      `.env` là bản thật và đã bị .gitignore — giữ nguyên như vậy.
#   2. Danh sách này phải khớp CODE, không khớp tài liệu thiết kế. Biến nào code
#      không còn đọc thì xoá; biến nào code đọc mà thiếu ở đây là một cái bẫy.
#
# Mỗi biến ghi 3 thứ: ai đọc nó · bắt buộc khi nào · lấy giá trị ở đâu

# ─────────────────────────────────────────────────────────────
# Bắt buộc
# ─────────────────────────────────────────────────────────────

# KHÔNG CÓ. Game chạy hoàn toàn trên máy người dùng, không server, không datastore,
# không khoá API. Xem NFR-SEC-04: một biến bắt buộc xuất hiện ở đây là dấu hiệu phải
# xem lại kiến trúc, không phải chuyện điền thêm một dòng.

# ─────────────────────────────────────────────────────────────
# Tuỳ chọn
# ─────────────────────────────────────────────────────────────

# đọc bởi:  scripts/check-audit.mjs, scripts/release-notes.sh
# mặc định: hỏi `gh` xem đang ở repo nào — nên ở máy không cần đặt
# việc:     GitHub Actions tự đặt biến này ("chu-so-huu/ten-repo"). Chỉ đặt bằng tay
#           khi muốn hai script đó hỏi về một repo khác.
# GITHUB_REPOSITORY=

# đọc bởi:  scripts/check-bundle-size.mjs
# mặc định: 150 — chính là ngưỡng NFR-PERF-05
# việc:     hạ xuống để siết thêm, hoặc nâng tạm khi đang điều tra. Nâng vĩnh viễn
#           thì phải sửa NFR-PERF-05 trước, không phải sửa biến này.
# BUNDLE_LIMIT_KB=

# đọc bởi:  next.config.ts, src/lib/auth/config.ts (redirect_uri)
# mặc định: không đặt hoặc để trống = trang phục vụ từ gốc "/"
# việc:     đặt "/web-game-duck-solitaire" thì Next thêm basePath cho GitHub Pages.
#           Chỉ workflow deploy đặt biến này; `pnpm dev` và `pnpm build` ở máy để trống.
NEXT_PUBLIC_BASE_PATH=

# ── Ducker ID sign-in (OIDC Authorization Code + PKCE, tuỳ chọn) ─────────
# Giao hàng ở trạng thái TẮT: deploy.yml không truyền cờ này, nên bản GitHub Pages
# không bao giờ hiện nút đăng nhập. Chỉ chạy ở máy. Xem ADR-0012.
# Bật khi cờ đúng bằng chuỗi "true" VÀ cả 4 giá trị dưới đây có mặt; thiếu một là tắt.
# Không có giá trị mặc định nào trong code.
#
# Đăng ký ở admin console của Ducker ID (client công khai, không secret):
#   redirect URI local: http://localhost:4184/   (pnpm build && node scripts/serve.mjs 4184 out)
#   redirect URI thật:  https://levananhduc.github.io/web-game-duck-solitaire/
# Và thêm origin của game (http://localhost:4184) vào CORS_ORIGINS của server Ducker ID.
NEXT_PUBLIC_FEATURE_DUCKER_SIGN_IN=
# Gốc của Ducker ID (nơi có /oauth/authorize, /oauth/token, /oauth/userinfo).
NEXT_PUBLIC_DUCKER_ISSUER=http://localhost:3000
# client_id của game này đã đăng ký trong admin console của Ducker ID.
NEXT_PUBLIC_DUCKER_CLIENT_ID=
# Scope xin khi đăng nhập — phải nằm trong allowed scopes của client.
NEXT_PUBLIC_DUCKER_SCOPE=openid profile email
# Trang hồ sơ trên Ducker ID mà menu tài khoản liên kết tới (tương đối với ISSUER).
NEXT_PUBLIC_DUCKER_PROFILE_PATH=/profile


